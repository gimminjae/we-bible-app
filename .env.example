EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Apple Sign In
# iOS native Sign in with Apple follows the Supabase React Native guide and uses
# @invertase/react-native-apple-authentication.
# These public values are still needed for Apple OAuth on Android / web and to keep the
# Supabase Apple provider configuration documented locally.
EXPO_PUBLIC_APPLE_AUTH_SERVICE_ID=""
EXPO_PUBLIC_APPLE_AUTH_REDIRECT_URI=""

# AdMob banner ads
EXPO_PUBLIC_ADMOB_BANNER_IOS_UNIT_ID=""
EXPO_PUBLIC_ADMOB_BANNER_ANDROID_UNIT_ID=""

# AdMob native ads
EXPO_PUBLIC_ADMOB_NATIVE_IOS_UNIT_ID=""
EXPO_PUBLIC_ADMOB_NATIVE_ANDROID_UNIT_ID=""

# AWS S3 image upload
# Expo runtime reads these values through app.config.ts.
NEXT_PUBLIC_AWS_REGION=""
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=""
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=""
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_AWS_S3_PUBLIC_BASE_URL=""
