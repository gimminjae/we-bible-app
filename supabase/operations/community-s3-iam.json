{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::YOUR-PRIVATE-COMMUNITY-BUCKET/staging/*",
        "arn:aws:s3:::YOUR-PRIVATE-COMMUNITY-BUCKET/attachments/*"
      ]
    }
  ]
}
