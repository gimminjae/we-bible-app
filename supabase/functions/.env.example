# Set these as Supabase Edge Function secrets. Never use EXPO_PUBLIC_ or app.config.ts.
COMMUNITY_AWS_REGION=ap-northeast-2
COMMUNITY_S3_BUCKET=
COMMUNITY_AWS_ACCESS_KEY_ID=
COMMUNITY_AWS_SECRET_ACCESS_KEY=
COMMUNITY_CLEANUP_SECRET=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase at runtime.
